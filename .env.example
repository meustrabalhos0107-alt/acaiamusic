# Copie este arquivo para ".env" e preencha. NUNCA coloque chaves reais neste arquivo de exemplo.

# Token GRATUITO do Hugging Face (gera a música com voz usando o ACE-Step)
# 1. Crie uma conta grátis em https://huggingface.co/join
# 2. Gere um token do tipo "Read" em https://huggingface.co/settings/tokens
HF_TOKEN=

# (Opcional) Space usado para gerar a música
# ACE_SPACE=victor/ace-step-jam

# Porta do servidor
PORT=3000
